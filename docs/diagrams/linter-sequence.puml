@startuml
title Linter — revisión de estilo

skinparam monochrome true
skinparam shadowing false
autonumber

actor Usuario
participant "CLI / consumidor" as Consumer
participant "LintConfig" as Config
participant "PrintScriptLinter" as Linter
participant "Reglas activas" as Rules
participant "AstTraversal" as Traversal
participant "Notificaciones" as Output

Usuario -> Consumer : solicita lint archivo
Consumer -> Config : carga o construye configuración
Config --> Consumer : LintConfig
Consumer -> Linter : PrintScriptLinter(config).lint(program)
activate Linter
Linter -> Linter : buildRules() según LintConfig
Linter -> Rules : registra IdentifierFormatRule

opt printlnArgumentCheck = true
  Linter -> Rules : registra PrintlnArgumentRule
end

opt readInputArgumentCheck = true
  Linter -> Rules : registra ReadInputArgumentRule
end

group Ejecuta cada regla activa sobre el Program
  Linter -> Rules : IdentifierFormatRule.check(program)
  Rules -> Rules : verifica camelCase o snake_case
  Rules --> Linter : notificaciones de formato

opt printlnArgumentCheck = true
  Linter -> Rules : PrintlnArgumentRule.check(program)
  Rules -> Rules : verifica identifier o literal
  Rules --> Linter : WARNING println-argument si corresponde
end

opt readInputArgumentCheck = true
  Linter -> Rules : ReadInputArgumentRule.check(program)
  Rules -> Traversal : forEachExpression(program)
  loop Cada statement, bloque y expresión anidada
    Traversal -> Traversal : visita if/else, binarias y lecturas
    alt ReadInput con Identifier o literal
      Traversal --> Rules : expresión válida
    else ReadInput con expresión compleja
      Traversal --> Rules : prompt inválido y posición
      Rules -> Output : ERROR read-input-argument
      Output --> Linter : notificación
    end
  end
end
end

Linter --> Consumer : List<LintNotification>
alt Lista vacía
  Consumer --> Usuario : "No se encontraron problemas."
else Hay notificaciones
  Consumer --> Usuario : muestra severidad, posición y mensaje
end
deactivate Linter
@enduml
