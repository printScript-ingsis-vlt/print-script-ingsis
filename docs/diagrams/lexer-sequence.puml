@startuml
title Lexer — selección y ejecución de TokenMatcher

skinparam monochrome true
skinparam shadowing false
autonumber

actor Usuario
participant "CLI / consumidor" as Consumer
participant "StreamLexer" as Lexer
participant "LexerCursor" as Cursor
participant "Reader" as Input
participant "TokenMatcher[]" as Matchers
participant "IdentifierMatcher" as Identifier
participant "NumberMatcher" as Number
participant "StringMatcher" as String
participant "OperatorMatcher" as Operator

Usuario -> Consumer : solicita tokenizar el código
Consumer -> Lexer : tokenize()
activate Lexer

loop mientras hasNext()
  Lexer -> Cursor : skipWhitespace()
  Cursor -> Input : peek()/read()
  Input --> Cursor : caracteres

  Lexer -> Cursor : position y peek()
  Cursor --> Lexer : start, first

  alt EOF
    Lexer -> Lexer : eof(start)
    Lexer --> Consumer : Success(EOF)

  else carácter inicial disponible
    Lexer -> Matchers : canStartWith(first)
    Matchers --> Lexer : candidatos

    alt exactamente un matcher
      alt identificador o keyword: "let"
        Lexer -> Identifier : match(cursor, start)
        Identifier -> Cursor : peek()/read() hasta delimitador
        Identifier --> Lexer : Success(LET, "let")

      else número decimal válido: "12.5"
        Lexer -> Number : match(cursor, start)
        Number -> Cursor : read dígitos y punto decimal
        Number --> Lexer : Success(NUMBER_LITERAL, "12.5")

      else string válido: "hola"
        Lexer -> String : match(cursor, start)
        String -> Cursor : read hasta comilla de cierre
        String --> Lexer : Success(STRING_LITERAL, "hola")

      else operador con máxima coincidencia: "==" (ejemplo no pedido en la consigna pero con soporte)
        Lexer -> Operator : match(cursor, start)
        Operator -> Cursor : peek()/read() mientras exista extensión
        Operator --> Lexer : Success(EQUAL_EQUAL, "==")

      else token malformado: "7."
        Lexer -> Number : match(cursor, start)
        Number -> Cursor : consume '7.' y valida dígito posterior
        Number --> Lexer : Failure(LexicalError)
        Lexer --> Consumer : detiene la tokenización
      end

    else ningún matcher acepta el carácter: "@"
      Lexer --> Consumer : Failure(LexicalError, carácter inesperado)

    else más de un matcher acepta el carácter
      Lexer -> Lexer : error de configuración ambigua
    end
  end
end

deactivate Lexer
@enduml
